# Copie para .env e preencha, depois rode com: export $(cat .env | xargs) && python collector.py

# Endereço BLE do anel (descubra com: colmi_r02_util scan)
RING_ADDRESS=30:36:44:34:F5:06

# URL do servidor central (troque pelo domínio/IP real, com https:// em produção)
API_URL=http://localhost:8000

# Mesma chave configurada no servidor (server/.env)
API_KEY=troque-por-uma-chave-secreta-forte

# 1 somente quando a API estiver atrás do túnel HTTPS e pronta para exposição
PUBLIC_EXPOSURE=0
ENV=dev

# Identifica de qual anel/paciente vem o dado, se tiver mais de um
DEVICE_ID=ring-01

# A cada quantos segundos lê tempo real (bpm + spo2)
RT_INTERVAL_SECONDS=60

# A cada quantos segundos sincroniza o histórico do anel
HISTORY_INTERVAL_SECONDS=1800
