# Copie para .env e rode com: export $(cat .env | xargs) && uvicorn api:app --host 0.0.0.0 --port 8000

# Precisa ser a MESMA chave usada no collector/.env
API_KEY=troque-por-uma-chave-secreta-forte

# Opcional: por padrão usa SQLite local (ring_data.sqlite).
# Pra Postgres: postgresql://usuario:senha@host:5432/ring_data
# DATABASE_URL=postgresql://usuario:senha@host:5432/ring_data
